# Copy to .env (cp .env.example .env) and fill in. Never commit .env.

# The sync key every device enters in Settings. Generate one with:
#   openssl rand -base64 32 | tr -d '/+=\n'; echo
SYNC_TOKEN=

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → the long token after --token (starts eyJ…)
TUNNEL_TOKEN=

# Where the app is served from (comma-separate several). The github.io address can be removed
# once no device still uses it.
ALLOWED_ORIGINS=https://timetracker.jayframemedia.com.au,https://jayframemedia.github.io
