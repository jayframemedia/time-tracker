# Copy to .env (cp .env.example .env) and fill in. Never commit .env.

# The OWNER's personal key (used the first time to create the owner). Staff keys are made with
#   docker compose exec sync node admin.mjs add "Name"
# Generate this one with:
#   openssl rand -base64 32 | tr -d '/+=\n'; echo
SYNC_TOKEN=

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → the long token after --token (starts eyJ…)
TUNNEL_TOKEN=

# Where the app is served from (comma-separate several)
ALLOWED_ORIGINS=https://timetracker.jayframemedia.com.au

# Your name as shown in the Team view (only used when the owner is first created)
OWNER_NAME=Owner
